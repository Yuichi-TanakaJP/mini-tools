{
  "name": "mini-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/run-next-build-filtered.mjs",
    "start": "next start",
    "lint": "node --import ./scripts/suppress-baseline-browser-mapping-warning.mjs ./node_modules/eslint/bin/eslint.js .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test --config=playwright.ui-smoke.config.ts",
    "check:navigation": "node scripts/check-navigation-contracts.mjs",
    "navigation:docs": "node scripts/check-navigation-contracts.mjs --write-docs",
    "test:navigation-contracts": "vitest run scripts/__tests__/navigation-contracts.test.mjs",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts",
    "prepare:dependencies": "node scripts/install-minimatch-compat.cjs",
    "postinstall": "npm run prepare:dependencies",
    "test:dependencies": "node --test scripts/check-minimatch-compat.mjs",
    "test:pwa-dependencies": "node --test scripts/check-pwa-dependencies.mjs",
    "test:pwa-migration": "playwright test --config=playwright.pwa-migration.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "@ducanh2912/next-pwa": "10.2.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@vitest/coverage-v8": "^4.1.2",
    "baseline-browser-mapping": "^2.10.27",
    "eslint": "9.39.2",
    "eslint-config-next": "^16.1.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.2",
    "@local/minimatch-legacy-bridge": "file:tooling/minimatch-legacy-bridge"
  },
  "overrides": {
    "serialize-javascript": "7.1.3",
    "@eslint/config-array@0.21.1": {
      "minimatch": "11.0.3"
    },
    "@eslint/eslintrc@3.3.3": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree@8.50.1": {
      "minimatch": "11.0.3"
    },
    "eslint@9.39.2": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-import@2.32.0": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-jsx-a11y@6.10.2": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-react@7.37.5": {
      "minimatch": "11.0.3"
    },
    "@ducanh2912/next-pwa@10.2.9": {
      "workbox-build": {
        ".": "7.4.1",
        "glob": "14.0.3",
        "filelist": {
          ".": "1.0.6",
          "minimatch": "11.0.3"
        }
      },
      "workbox-core": "7.4.1",
      "workbox-webpack-plugin": {
        ".": "7.4.1",
        "workbox-build": {
          ".": "7.4.1",
          "glob": "14.0.3",
          "filelist": {
            ".": "1.0.6",
            "minimatch": "11.0.3"
          }
        }
      },
      "workbox-window": "7.4.1"
    }
  },
  "engines": {
    "node": "^22.23.4"
  }
}
